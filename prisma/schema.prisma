generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_EDITOR
  TEAM_MANAGER
  VOLUNTEER_MANAGER
  VOLUNTEER
}

enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VOLUNTEER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        Profile?
  teamMember     TeamMember?
  volunteer      Volunteer?
  sessions       Session[]
  awardedBadges  UserBadge[] @relation("AwardedBadges")
  assignedBadges UserBadge[] @relation("AssignedBadges")

  @@map("users")
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?
  image      String?
  location   String?
  linkedin   String?
  twitter    String?
  instagram  String?
  website    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model TeamMember {
  id           String   @id @default(cuid())
  userId       String   @unique
  position     String
  department   String
  bio          String?
  location     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

model Volunteer {
  id                  String   @id @default(cuid())
  userId              String   @unique
  skills              String[]
  interests           String[]
  joinedAt            DateTime @default(now())
  contributionHistory String?
  projectsParticipated String[]
  isPublic            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteers")
}

model Badge {
  id          String     @id @default(cuid())
  name        String     @unique
  description String
  icon        String?
  level       BadgeLevel @default(BRONZE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  awardedTo UserBadge[]

  @@map("badges")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  assignedBy  String
  awardedAt   DateTime @default(now())

  user     User @relation("AwardedBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  admin    User @relation("AssignedBadges", fields: [assignedBy], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}
